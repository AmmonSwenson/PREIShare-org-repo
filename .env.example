# .env.example — commit this file. Never put real keys here.
# Copy to .env.local (or .env) for local development and fill in values
# from Supabase → Project Settings → API.
#
# This repo is TanStack Start + Vite. Client-exposed vars MUST use the VITE_
# prefix (import.meta.env.VITE_*). Anything without VITE_ is for server-only
# process.env reads inside createServerFn / createServerOnlyFn / loaders.
# See docs/requirements/sponsor-auth-and-listings-brief.md (secret hygiene).

# ---------------------------------------------------------------------------
# PUBLIC / BROWSER-SAFE (may be exposed to the client bundle)
# These are NOT secrets when Row Level Security is enabled. The anon /
# publishable key cannot bypass RLS. Never put the service-role key here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS (no VITE_ prefix; never import in browser code)
# The service role bypasses Row Level Security. Server routes/loaders only.
# Never name this VITE_SUPABASE_SERVICE_ROLE_KEY.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same project URL for server code that reads non-VITE_ vars (process.env).
SUPABASE_URL=https://your-project-ref.supabase.co

# Optional server-side anon key alias (same value as VITE_SUPABASE_ANON_KEY).
# Prefer this in createServerFn if you do not want a VITE_ read on the server.
SUPABASE_ANON_KEY=your-anon-or-publishable-key
